{$DOMAIN} {
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy web:80
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>X-Telegram-Bot-Api-Secret-Token delete
                request>headers>Cookie delete
                request>headers>Authorization delete
            }
        }
    }
}

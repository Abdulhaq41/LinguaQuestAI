# Never commit a populated .env. Production must use HTTPS and PostgreSQL.
APP_ENV=development
ENABLE_DEV_AUTH=true
DATABASE_URL=sqlite:///./linguaquest.db
WEBAPP_URL=http://localhost:5173
BOT_TOKEN=
BOT_USERNAME=
WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=
SUPPORT_CONTACT=
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_DAILY_TOKEN_BUDGET=100000
# Estimates only; update to provider's current prices before enabling AI.
AI_INPUT_USD_PER_MILLION=0.4
AI_OUTPUT_USD_PER_MILLION=1.6

# Enable only after legal review, support setup and real Telegram payment validation.
COMMERCE_ENABLED=false

# Docker Compose production values (set securely on your host).
DOMAIN=
POSTGRES_PASSWORD=
